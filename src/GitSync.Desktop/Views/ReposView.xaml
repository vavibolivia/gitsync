<UserControl x:Class="GitSync.Desktop.Views.ReposView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header ═══════════════ -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="저장소 비교" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Dim}" FontSize="13"
                           Text="모든 GitHub 저장소를 GitLab과 브랜치 단위로 비교하고, 없는 저장소·브랜치는 생성해 업데이트합니다."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" ToolTip="모든 저장소를 다시 검색하고 API로 빠르게 비교합니다">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/>
                        <TextBlock Text="전체 검색" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding AnalyzeAllCommand}"
                        ToolTip="현재 목록의 저장소를 가져와(fetch) 커밋 단위로 정밀 비교합니다">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                        <TextBlock Text="정밀 분석" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GitLabButton}" Margin="8,0,0,0" Command="{Binding SyncAllToGitLabCommand}"
                        ToolTip="현재 목록의 모든 저장소를 GitLab으로 푸시합니다 (없으면 생성)">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitLabGeometry}" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                        <TextBlock Text="GitLab으로 전체 동기화" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Height="34" Width="34" Margin="8,0,0,0" Click="OnMoreClick" ToolTip="더 보기">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE712;"/>
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding SyncAllToGitHubCommand}">
                                <MenuItem.Icon>
                                    <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextBrush}" Width="15" Height="15" Stretch="Uniform"/>
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <StackPanel>
                                        <TextBlock Text="GitHub으로 전체 동기화" FontWeight="SemiBold"/>
                                        <TextBlock Text="GitLab → GitHub 방향 (역방향)" FontSize="11.5" Foreground="{StaticResource TextMuteBrush}"/>
                                    </StackPanel>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Command="{Binding NavigateCommand}" CommandParameter="Log">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;"/>
                                </MenuItem.Icon>
                                <MenuItem.Header>
                                    <TextBlock Text="활동 로그 보기"/>
                                </MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════ Stats / filters ═══════════════ -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,0,-12,18">
            <RadioButton Style="{StaticResource StatCard}" GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="All"
                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EqToBool}, ConverterParameter=All}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="12" Foreground="{StaticResource AccentHoverBrush}"/>
                        <TextBlock Text="전체" Style="{StaticResource Dim}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource StatCard}" GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="Synced"
                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EqToBool}, ConverterParameter=Synced}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="동기화됨" Style="{StaticResource Dim}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SyncedCount}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource StatCard}" GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="OutOfSync"
                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EqToBool}, ConverterParameter=OutOfSync}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}"/>
                        <TextBlock Text="차이 있음" Style="{StaticResource Dim}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OutOfSyncCount}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource StatCard}" GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="GitHubOnly"
                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EqToBool}, ConverterParameter=GitHubOnly}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextDimBrush}" Width="12" Height="12" Stretch="Uniform"/>
                        <TextBlock Text="GitLab에 없음" Style="{StaticResource Dim}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GitHubOnlyCount}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource StatCard}" GroupName="Filter" Command="{Binding SetFilterCommand}" CommandParameter="GitLabOnly"
                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource EqToBool}, ConverterParameter=GitLabOnly}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource GitLabGeometry}" Fill="{StaticResource GitLabBrush}" Width="12" Height="12" Stretch="Uniform"/>
                        <TextBlock Text="GitHub에 없음" Style="{StaticResource Dim}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GitLabOnlyCount}" FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- ═══════════════ Master / detail ═══════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Repo list -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="12,12,12,8">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="저장소 검색…" Padding="34,0,10,0"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource TextMuteBrush}"
                                   Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox Grid.Row="1" Style="{StaticResource CleanListBox}" ItemsSource="{Binding PairsView}"
                             SelectedItem="{Binding SelectedPair}" ItemContainerStyle="{StaticResource RepoItem}" Padding="8,0,8,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Path Data="{StaticResource GitHubGeometry}" Width="12" Height="12" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource TextDimBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasGitHub}" Value="False">
                                                                <Setter Property="Opacity" Value="0.2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="{StaticResource GitLabGeometry}" Width="12" Height="12" Stretch="Uniform" Margin="5,0,0,0">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource GitLabBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasGitLab}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource TextMuteBrush}"/>
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="11.5" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Soft}"
                                                Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                        <ContentControl Style="{StaticResource Spinner}" Width="15" Height="15" HorizontalAlignment="Right"
                                                        Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- empty list -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasPairs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TextMuteBrush}"/>
                        <TextBlock Text="저장소가 없습니다" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="설정에서 토큰을 입력한 뒤 '전체 검색'을 누르세요." Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════ Detail ═══════════════ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedPair, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Border CornerRadius="3" Background="{StaticResource BrandGradient}" Opacity="0.18"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}"/>
                        </Grid>
                        <TextBlock Text="저장소를 선택하세요" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock Text="왼쪽 목록에서 저장소를 선택하면 브랜치별 비교 결과가 표시됩니다." Style="{StaticResource Dim}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid DataContext="{Binding SelectedPair}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Repo header -->
                        <Border CornerRadius="3,3,0,0" Background="{StaticResource HeroGradient}" Padding="24,20,24,18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15"/>
                                    <Border Style="{StaticResource Pill}" Margin="12,0,0,0"
                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Soft}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="6,0,0,0" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding VisibilityText}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Style="{StaticResource Spinner}"/>
                                    <TextBlock Text="{Binding WorkMessage}" Margin="8,0,0,0" Style="{StaticResource Dim}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{StaticResource Dim}" Margin="0,6,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource NullToVis}}"/>

                                <!-- Side chips -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Style="{StaticResource SecondaryButton}" Height="44" HorizontalContentAlignment="Stretch"
                                            Command="{Binding OpenGitHubCommand}" ToolTip="브라우저에서 열기">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="GitHub" FontSize="10.5" Foreground="{StaticResource TextMuteBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding GitHub.FullName, FallbackValue='없음', TargetNullValue='없음'}" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{StaticResource TextMuteBrush}"/>
                                        </Grid>
                                    </Button>

                                    <Grid Grid.Column="1" Width="44">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource TextMuteBrush}"/>
                                    </Grid>

                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="44" HorizontalContentAlignment="Stretch"
                                            Command="{Binding OpenGitLabCommand}" ToolTip="브라우저에서 열기">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource GitLabGeometry}" Fill="{StaticResource GitLabBrush}" Width="18" Height="18" Stretch="Uniform"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="GitLab" FontSize="10.5" Foreground="{StaticResource TextMuteBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding GitLab.FullName, FallbackValue='없음 — 생성 가능', TargetNullValue='없음 — 생성 가능'}" FontWeight="Normal" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{StaticResource TextMuteBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <Grid Grid.Row="1" Margin="24,16,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource Dim}" FontSize="12"/>
                                <TextBlock Text="{Binding TagText}" Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"
                                           Visibility="{Binding TagText, Converter={StaticResource NullToVis}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding AnalyzeCommand}"
                                        ToolTip="양쪽을 가져와 커밋 단위로 정밀 비교합니다">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;"/>
                                        <TextBlock Text="정밀 분석" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SyncToGitHubCommand}"
                                        ToolTip="GitLab → GitHub 방향으로 푸시합니다">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextBrush}" Width="13" Height="13" Stretch="Uniform"/>
                                        <TextBlock Text="GitHub으로" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GitLabButton}" Margin="8,0,0,0" Command="{Binding SyncToGitLabCommand}"
                                        ToolTip="GitHub → GitLab: 없으면 저장소/브랜치를 생성하고 업데이트합니다">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource GitLabGeometry}" Fill="White" Width="13" Height="13" Stretch="Uniform"/>
                                        <TextBlock Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="GitLab으로 동기화"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MissingGitLab}" Value="True">
                                                            <Setter Property="Text" Value="GitLab에 생성 + 푸시"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Error banner -->
                        <Border Grid.Row="2" Margin="24,14,24,0" CornerRadius="3" Padding="14,10" Background="#1FF2606E"
                                BorderBrush="#55F2606E" BorderThickness="1"
                                Visibility="{Binding Error, Converter={StaticResource NullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Binding Error}" Margin="10,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" MaxWidth="760"/>
                            </StackPanel>
                        </Border>

                        <!-- Branch table -->
                        <Grid Grid.Row="3" Margin="16,14,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- one-sided repo notice -->
                            <Border Grid.RowSpan="2" Visibility="{Binding HasBoth, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource InfoBrush}"/>
                                    <TextBlock HorizontalAlignment="Center" Margin="0,12,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource H3}">
                                                <Setter Property="Text" Value="GitLab에 이 저장소가 없습니다"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MissingGitHub}" Value="True">
                                                        <Setter Property="Text" Value="GitHub에 이 저장소가 없습니다"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                               Text="위의 동기화 버튼을 누르면 대상에 저장소를 만들고 모든 브랜치와 태그를 복사합니다."/>
                                </StackPanel>
                            </Border>

                            <!-- header -->
                            <Grid Margin="10,0,10,8" Visibility="{Binding HasBoth, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                    <ColumnDefinition Width="168"/>
                                    <ColumnDefinition Width="136"/>
                                    <ColumnDefinition Width="168"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="브랜치" Style="{StaticResource Caption}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextMuteBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                    <TextBlock Text="GITHUB" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="상태" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Path Data="{StaticResource GitLabGeometry}" Fill="{StaticResource TextMuteBrush}" Width="11" Height="11" Stretch="Uniform"/>
                                    <TextBlock Text="GITLAB" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="작업" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </Grid>

                            <ListBox Grid.Row="1" Style="{StaticResource CleanListBox}" ItemsSource="{Binding Branches}"
                                     ItemContainerStyle="{StaticResource PlainItem}"
                                     Visibility="{Binding HasBoth, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="3" Padding="10,9" Margin="0,0,0,4"
                                                Background="#08FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                                    <ColumnDefinition Width="168"/>
                                                    <ColumnDefinition Width="136"/>
                                                    <ColumnDefinition Width="168"/>
                                                    <ColumnDefinition Width="76"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- name -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE734;" FontSize="12" Foreground="{StaticResource WarningBrush}"
                                                               Margin="0,0,7,0" ToolTip="기본 브랜치"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Mono}" FontSize="12.5" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                </StackPanel>

                                                <!-- github -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding GitHubSubject}">
                                                    <TextBlock Text="{Binding GitHubShort}" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{Binding GitHubMeta}" Style="{StaticResource Dim}" FontSize="11"
                                                               Visibility="{Binding GitHubMeta, Converter={StaticResource NullToVis}}"/>
                                                </StackPanel>

                                                <!-- status -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Center"
                                                            Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=Soft}">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding AheadText}" FontSize="10.5" Foreground="{StaticResource TextMuteBrush}"
                                                               HorizontalAlignment="Center" Margin="0,3,0,0"
                                                               Visibility="{Binding AheadText, Converter={StaticResource NullToVis}}"/>
                                                </StackPanel>

                                                <!-- gitlab -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding GitLabSubject}">
                                                    <TextBlock Text="{Binding GitLabShort}" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{Binding GitLabMeta}" Style="{StaticResource Dim}" FontSize="11"
                                                               Visibility="{Binding GitLabMeta, Converter={StaticResource NullToVis}}"/>
                                                </StackPanel>

                                                <!-- actions -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource IconButton}" Command="{Binding PushToGitHubCommand}" ToolTip="{Binding PushToGitHubTip}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" Command="{Binding PushToGitLabCommand}" ToolTip="{Binding PushToGitLabTip}"
                                                            Foreground="{StaticResource GitLabBrush}" BorderBrush="#55FC6D26">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF"/>
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
