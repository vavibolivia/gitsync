<Application x:Class="GitSync.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitSync.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:EqualsToVisibilityConverter x:Key="EqToVis"/>
            <conv:EqualsToBoolConverter x:Key="EqToBool"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
            <conv:StatusBrushConverter x:Key="StatusBrush"/>
            <conv:StatusTextConverter x:Key="StatusText"/>
            <conv:LogIconConverter x:Key="LogIcon"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
