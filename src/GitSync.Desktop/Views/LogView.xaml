<UserControl x:Class="GitSync.Desktop.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,4,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="활동 로그" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Dim}" FontSize="13"
                           Text="검색, 비교, git fetch / push 실행 내역과 오류 상세를 확인합니다."/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;"/>
                    <TextBlock Text="지우기" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ListBox Style="{StaticResource CleanListBox}" ItemsSource="{Binding Logs}" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="12,9" CornerRadius="3" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Style="{StaticResource Mono}" FontSize="11.5"
                                               Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,0,0"
                                               Text="{Binding Level, Converter={StaticResource LogIcon}}"
                                               Foreground="{Binding Level, Converter={StaticResource StatusBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Scope}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Top" ToolTip="{Binding Scope}"/>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock x:Name="Msg" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5"/>
                                        <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="3" Background="{StaticResource InputBrush}"
                                                Visibility="{Binding Detail, Converter={StaticResource NullToVis}}">
                                            <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                                     Background="Transparent" Padding="0" MinHeight="0" FontFamily="{StaticResource MonoFont}"
                                                     FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#08FFFFFF"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Level}" Value="Command">
                                    <Setter TargetName="Msg" Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                    <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                    <Setter TargetName="Msg" Property="FontSize" Value="11.5"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Logs.Count, Converter={StaticResource CountToVis}, ConverterParameter=Invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource TextMuteBrush}"/>
                    <TextBlock Text="기록이 없습니다" Style="{StaticResource Dim}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
