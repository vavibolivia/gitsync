<Window x:Class="GitSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GitSync.Desktop.Views"
        Title="GitSync" Icon="Assets/GitSync.ico" Width="1460" Height="900" MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Sidebar ═══════════════ -->
        <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="6,22,0,28">
                    <Grid Width="40" Height="40">
                        <Border CornerRadius="12" Background="{StaticResource BrandGradient}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="19" Foreground="White" HorizontalAlignment="Center"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GitSync" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="GitHub ⇄ GitLab" FontSize="11.5" Foreground="{StaticResource TextMuteBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="메뉴" Style="{StaticResource Caption}" Margin="8,0,0,8"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqToBool}, ConverterParameter=Repos}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="저장소 비교" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="7,1" Background="#33F2B84B"
                                    Visibility="{Binding OutOfSyncCount, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding OutOfSyncCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqToBool}, ConverterParameter=Log}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="활동 로그" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Padding="7,1" Background="#33F2606E"
                                    Visibility="{Binding ErrorLogCount, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding ErrorLogCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqToBool}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15"/>
                            <TextBlock Text="설정" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Connections -->
                <StackPanel Grid.Row="3">
                    <TextBlock Text="실행 위치" Style="{StaticResource Caption}" Margin="8,0,0,8"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,9" Margin="0,0,0,14" Cursor="Hand" ToolTip="설정에서 변경">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="15" Foreground="{StaticResource AccentHoverBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE7F4;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerMode}" Value="True">
                                                <Setter Property="Text" Value="&#xE968;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExecutionLocation}" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="연결" Style="{StaticResource Caption}" Margin="8,0,0,8"/>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource GitHubGeometry}" Fill="{StaticResource TextBrush}" Width="20" Height="20" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Text="{Binding GitHubUser, TargetNullValue='연결 안 됨'}"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GitHubUser}" Value="{x:Null}">
                                                <Setter Property="Fill" Value="{StaticResource TextMuteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource GitLabGeometry}" Fill="{StaticResource GitLabBrush}" Width="20" Height="20" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding GitLabHost}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{StaticResource Dim}" FontSize="11.5" Text="{Binding GitLabUser, TargetNullValue='연결 안 됨'}"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GitLabUser}" Value="{x:Null}">
                                                <Setter Property="Fill" Value="{StaticResource TextMuteBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Main area ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid>
                <Grid.Background>
                    <SolidColorBrush Color="Transparent"/>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimize" ToolTip="최소화">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaximize" ToolTip="최대화">
                        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="닫기">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Pages -->
            <Grid Grid.Row="1">
                <views:ReposView Visibility="{Binding CurrentPage, Converter={StaticResource EqToVis}, ConverterParameter=Repos}"/>
                <views:LogView Visibility="{Binding CurrentPage, Converter={StaticResource EqToVis}, ConverterParameter=Log}"/>
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqToVis}, ConverterParameter=Settings}"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource Bg1Brush}">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Spinner}" Width="13" Height="13" Margin="0,0,8,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="2,0,10,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BusyMessage}" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                        <ProgressBar Style="{StaticResource ThinProgress}" Width="140" Margin="12,0,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource GhostButton}" Height="22" Padding="8,0" Margin="8,0,0,0" FontSize="11.5"
                                Content="취소" Command="{Binding CancelCommand}"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" FontSize="12" Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding LastScanText, Mode=OneWay}"/>
                        <Run Text="  ·  "/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text="개 저장소"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ Toast ═══════════════ -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,52"
                MaxWidth="520" Background="#1C2130" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14,12" Effect="{StaticResource PopupShadow}" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="16"/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="16" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                            <Setter Property="IsHitTestVisible" Value="True"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Top"
                        Background="{Binding ToastKind, Converter={StaticResource StatusBrush}, ConverterParameter=Soft}">
                    <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="13"
                               Text="{Binding ToastKind, Converter={StaticResource LogIcon}}"
                               Foreground="{Binding ToastKind, Converter={StaticResource StatusBrush}}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" TextWrapping="Wrap" Margin="12,0,12,0"
                           VerticalAlignment="Center" FontSize="13" LineHeight="19"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="24" Height="24" Padding="0"
                        VerticalAlignment="Top" Command="{Binding DismissToastCommand}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="9"/>
                </Button>
            </Grid>
        </Border>

        <!-- Dim overlay for dialogs -->
        <Border x:Name="DimOverlay" Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="Collapsed"/>
    </Grid>
</Window>
