<Window x:Class="GitSync.Desktop.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SizeToContent="Height" Width="520"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="24" Background="#181818" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
            CornerRadius="3">
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="3" Background="#264C8DFF">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" Text="&#xE895;" FontSize="16"
                               HorizontalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="{StaticResource TextDimBrush}" LineHeight="20"/>

            <Border x:Name="DetailsBox" Grid.Row="2" Margin="0,14,0,0" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14,10">
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Mono}" Margin="0,3" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="취소" Style="{StaticResource SecondaryButton}" MinWidth="88" IsCancel="True" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="110" Margin="10,0,0,0"
                        IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
