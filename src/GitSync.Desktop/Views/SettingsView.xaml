<UserControl x:Class="GitSync.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:GitSync.Desktop.Infrastructure"
             xmlns:v="clr-namespace:GitSync.Desktop.Views">
    <UserControl.Resources>
        <Style x:Key="TestResult" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,28,20">
            <StackPanel>
                <TextBlock Text="설정" Style="{StaticResource H1}"/>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Dim}" FontSize="13"
                           Text="GitHub와 GitLab의 주소 · ID · 키를 입력하고 저장하세요. 저장소는 그 다음 '저장소 비교' 화면에서 직접 추가합니다."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="저장되지 않은 변경" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="120" Content="저장"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,28,24">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- GitHub -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GitHub" Style="{StaticResource H3}" FontSize="15" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="주소 (URL 또는 IP)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding GitHubApiUrl, UpdateSourceTrigger=PropertyChanged}" Tag="github.com"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}" Tag="GitHub 사용자 이름"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="키" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding GitHubTokenState}" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <v:SecretBox Secret="{Binding GitHubToken, Mode=TwoWay}" ToolTip="{Binding TokenHint}"/>
                            </StackPanel>
                            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="36" VerticalAlignment="Bottom"
                                    Command="{Binding TestGitHubCommand}" Content="연결 테스트"/>
                        </Grid>
                        <TextBlock Text="{Binding GitHubTestResult}" Visibility="{Binding GitHubTestResult, Converter={StaticResource NullToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TestResult}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GitHubTestOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="키 = Personal Access Token (github.com → Settings → Developer settings). GitHub은 비밀번호 로그인을 막고 있어 비밀번호는 쓸 수 없습니다. 필요 권한: repo. 주소는 비우면 github.com, 사내 GitHub Enterprise는 호스트나 IP만 넣으면 됩니다(http면 http:// 까지 입력). ID를 비우면 키의 계정을 쓰고, 조직 이름을 넣으면 그 조직의 저장소를 불러옵니다."/>
                    </StackPanel>
                </Border>

                <!-- GitLab -->
                <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GitLab" Style="{StaticResource H3}" FontSize="15" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="주소 (URL 또는 IP)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding GitLabUrl, UpdateSourceTrigger=PropertyChanged}" Tag="gitlab.com"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding GitLabUser, UpdateSourceTrigger=PropertyChanged}" Tag="GitLab 사용자 이름"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="키" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding GitLabTokenState}" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <v:SecretBox Secret="{Binding GitLabToken, Mode=TwoWay}" ToolTip="{Binding TokenHint}"/>
                            </StackPanel>
                            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="36" VerticalAlignment="Bottom"
                                    Command="{Binding TestGitLabCommand}" Content="연결 테스트"/>
                        </Grid>
                        <TextBlock Text="{Binding GitLabTestResult}" Visibility="{Binding GitLabTestResult, Converter={StaticResource NullToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TestResult}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GitLabTestOk}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="키 = Personal Access Token (GitLab → Preferences → Access tokens). gitlab.com도 비밀번호 로그인을 받지 않습니다. 필요 권한: api, write_repository. 주소는 비우면 gitlab.com, 사내 서버는 호스트나 IP만 넣으면 됩니다(http면 http:// 까지 입력). ID를 입력하면 키의 계정과 일치하는지 확인합니다."/>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="3">
                                    <TextBlock Text="불러올 그룹" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding GitLabGroup, UpdateSourceTrigger=PropertyChanged}" Tag="비워두면 내가 속한 모든 프로젝트"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="예: mycompany/mirrors — 하위 그룹 포함"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="새 프로젝트 생성 위치" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding GitLabTargetNamespace, UpdateSourceTrigger=PropertyChanged}" Tag="비워두면 불러올 그룹 또는 내 네임스페이스"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="새 프로젝트 공개 범위" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding GitLabVisibility}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="source = GitHub 저장소와 동일하게"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowAdvanced}" Margin="0,0,0,16">
                    <TextBlock Text="고급 설정 표시" FontWeight="SemiBold"/>
                </CheckBox>

                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">

                    <!-- Connection mode -->
                    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="실행 위치" Style="{StaticResource H3}" FontSize="15"/>
                                    <TextBlock Text="동기화(git fetch/push)를 이 PC에서 할지, GitSync 서버에서 할지 선택합니다" Style="{StaticResource Dim}" FontSize="12"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="이 PC에서 실행"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EqToBool}, ConverterParameter=Local}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="GitSync 서버에 연결"
                                                     IsChecked="{Binding Mode, Converter={StaticResource EqToBool}, ConverterParameter=Server}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="서버 주소" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" Tag="http://서버주소:8080"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="접근 키" Style="{StaticResource FieldLabel}"/>
                                        <v:SecretBox Secret="{Binding ServerKey, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="36" VerticalAlignment="Bottom"
                                            Command="{Binding TestServerCommand}" Content="서버 연결 · 설정 불러오기"/>
                                </Grid>
                                <TextBlock Text="{Binding ServerTestResult}" Visibility="{Binding ServerTestResult, Converter={StaticResource NullToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TestResult}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ServerTestOk}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="실행 중인 GitSync 서버의 주소와 접근 키(GITSYNC_ACCESS_KEY)를 입력하세요. 서버 모드에서는 GitHub · GitLab · 동기화 설정이 서버에 저장되고, 서버가 모든 저장소를 자동으로 검색합니다(저장소 직접 추가는 이 PC에서 실행할 때만 가능)."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sync options -->
                    <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="동기화 옵션" Style="{StaticResource H3}" FontSize="15" Margin="0,0,0,14"/>

                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CreateMissingRepos}" Margin="0,0,16,12">
                                    <StackPanel>
                                        <TextBlock Text="없는 저장소 자동 생성" FontWeight="SemiBold"/>
                                        <TextBlock Text="대상에 없으면 만든 뒤 푸시" Style="{StaticResource Dim}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncTags}" Margin="0,0,16,12">
                                    <StackPanel>
                                        <TextBlock Text="태그 동기화" FontWeight="SemiBold"/>
                                        <TextBlock Text="누락된 태그 푸시" Style="{StaticResource Dim}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeArchived}" Margin="0,0,16,12">
                                    <StackPanel>
                                        <TextBlock Text="보관된 저장소 포함" FontWeight="SemiBold"/>
                                        <TextBlock Text="archived 저장소도 불러오기" Style="{StaticResource Dim}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdate}" Margin="0,0,16,12">
                                    <StackPanel>
                                        <TextBlock Text="자동 업데이트" FontWeight="SemiBold"/>
                                        <TextBlock Text="새 버전이 나오면 받아서 다시 시작 (설정은 유지)" Style="{StaticResource Dim}" FontSize="11.5"/>
                                    </StackPanel>
                                </CheckBox>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="자동 동기화 주기 (분)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AutoSyncMinutes, UpdateSourceTrigger=LostFocus}" Width="160" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="0 = 끔. 설정하면 서버가 주기마다 전체 검색 후 GitHub → GitLab 동기화를 실행합니다."/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsLocalMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="로컬 캐시 폴더" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding CacheRoot, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Command="{Binding OpenCacheCommand}" Content="열기"/>
                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="36" Margin="6,0,0,0" Command="{Binding ResetCacheCommand}" Content="기본값"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="비교·푸시용 bare 미러가 저장됩니다. 키는 git 설정에 저장되지 않습니다."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="동시 작업 수" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding MaxParallel, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="1 – 8"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="이름 매핑" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <TextBox Text="{Binding NameMappings, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                         Height="104" VerticalContentAlignment="Top" Padding="10,8" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                                         Tag="github-repo=gitlab-project   또는   github-repo=group/sub/project"/>
                                <TextBlock Style="{StaticResource Hint}" Text="서버 모드 전용. 기본은 같은 이름끼리 매칭하며, 이름이 다를 때만 한 줄에 하나씩 지정합니다."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Rules -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="18,14">
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" LineHeight="19">
                        <Run Text="동기화 규칙" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <LineBreak/>
                        <Run Text="• 대상에 없는 저장소와 브랜치는 새로 생성합니다."/>
                        <LineBreak/>
                        <Run Text="• 대상이 뒤처진 브랜치는 fast-forward 로 업데이트합니다."/>
                        <LineBreak/>
                        <Run Text="• 양쪽에 서로 다른 커밋이 있는(분기된) 브랜치는 절대 자동으로 덮어쓰지 않으며, 브랜치 행의 화살표 버튼으로 확인 후 강제 푸시할 수 있습니다."/>
                        <LineBreak/>
                        <Run Text="• 키는 Windows DPAPI 로 암호화되어 현재 사용자 계정에만 저장됩니다."/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
