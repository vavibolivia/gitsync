<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════ Fonts ═══════════════ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Semibold, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ═══════════════ Palette ═══════════════ -->
    <Color x:Key="Bg0Color">#111111</Color>
    <Color x:Key="Bg1Color">#161616</Color>
    <Color x:Key="CardColor">#181818</Color>
    <Color x:Key="CardHoverColor">#202020</Color>
    <Color x:Key="InputColor">#0D0D0D</Color>
    <Color x:Key="BorderColor">#2A2A2A</Color>
    <Color x:Key="BorderStrongColor">#3A3A3A</Color>
    <Color x:Key="TextColor">#E6E6E6</Color>
    <Color x:Key="TextDimColor">#A0A0A0</Color>
    <Color x:Key="TextMuteColor">#6E6E6E</Color>
    <Color x:Key="AccentColor">#4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#6BA1FF</Color>
    <Color x:Key="SuccessColor">#3DD68C</Color>
    <Color x:Key="WarningColor">#F2B84B</Color>
    <Color x:Key="DangerColor">#F2606E</Color>
    <Color x:Key="InfoColor">#5AA8FF</Color>
    <Color x:Key="GitLabColor">#FC6D26</Color>
    <Color x:Key="GitHubAccentColor">#9DB4D6</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextMuteBrush" Color="{StaticResource TextMuteColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264C8DFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="GitLabBrush" Color="{StaticResource GitLabColor}"/>
    <SolidColorBrush x:Key="GitHubAccentBrush" Color="{StaticResource GitHubAccentColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000"/>

    <SolidColorBrush x:Key="BrandGradient" Color="{StaticResource AccentColor}"/>

    <SolidColorBrush x:Key="HeroGradient" Color="{StaticResource Bg1Color}"/>

    <!-- ═══════════════ Logos ═══════════════ -->
