<UserControl x:Class="GitSync.Desktop.Views.SecretBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Masked view -->
        <PasswordBox x:Name="Masked" Grid.Column="0" PasswordChanged="OnMaskedChanged"/>
        <!-- Revealed view (same place, shown only while the eye is on) -->
        <TextBox x:Name="Plain" Grid.Column="0" Visibility="Collapsed"
                 TextChanged="OnPlainChanged" FontFamily="{StaticResource MonoFont}"/>

        <Button x:Name="Toggle" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                Width="40" Height="36" Margin="6,0,0,0" Click="OnToggle"
                ToolTip="키 보기/가리기">
            <TextBlock x:Name="Eye" Style="{StaticResource Icon}" Text="&#xE7B3;" HorizontalAlignment="Center"/>
        </Button>
    </Grid>
</UserControl>
